{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "TwexAPI",
  "description": "TwexAPI docs for tweet search, follower scraping, timelines, DMs, SDKs, MCP, CLI, Terraform, n8n, Prefect, Haystack, and Paperclip. Not affiliated with X Corp.",
  "search": {
    "prompt": "Search docs"
  },
  "colors": {
    "primary": "#0F172A",
    "light": "#334155",
    "dark": "#F8FAFC"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://twexapi.io"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "banner": {
    "content": "**TwexAPI is not affiliated with or endorsed by X Corp.**",
    "dismissible": false
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://twexapi.io/dashboard"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://twexapi.io/dashboard"
    }
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "go"
      ]
    },
    "mdx": {
      "server": "https://api.twexapi.io",
      "auth": {
        "method": "bearer"
      }
    }
  },
